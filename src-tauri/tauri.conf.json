{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Egg",
  "mainBinaryName": "Egg",
  "version": "0.2.1",
  "identifier": "com.antoi.eggs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Egg",
        "width": 800,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/toniomasterflex/eggs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NENGQThBQzY4M0M5MApSV1NRUEdpc3FNOUVEZThxZ2dXVW1TbUhjZ1dQdUpNVDc3MjJTbnFEVU1lRTA4eUNJdVM4d0Q2VAo="
    },
    "deep-link": {
      "desktop": {
        "schemes": ["eggs"]
      }
    }
  }
}